<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F4F7FC">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="پلنر · کارهای امروز"
        android:textColor="#26354A"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingBottom="8dp" />
    <TextView
        android:id="@+id/widget_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="برای نمایش کارها، برنامه را باز کنید"
        android:textColor="#26354A"
        android:textSize="13sp"
        android:lineSpacingExtra="5dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_task_0" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_task_1" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_task_2" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_task_3" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_task_4" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ افزودن کار" android:textColor="#FFFFFF" android:background="#397DE6" android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
